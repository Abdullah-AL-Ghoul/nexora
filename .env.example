# NEXORA — environment template. Copy to .env and fill values.
# NEVER commit real secrets.

# --- Database ---
# Local:  postgresql://user:password@localhost:5432/nexora?schema=public
# Supabase (later): postgresql://postgres.<ref>:<password>@aws-0..region.pooler.supabase.com:6543/postgres?schema=public
DATABASE_URL=""

# --- Auth (better-auth) ---
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe (TEST MODE ONLY) ---
# Leave empty to disable payment flows entirely.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

